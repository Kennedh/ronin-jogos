{
  "name": "ronin-jogos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ronin/portal",
    "dev:api": "node apps/api/src/main.ts",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "redocly lint docs/openapi.ronin-runner.v1.yaml && node scripts/generate-contracts.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check apps packages scripts tests package.json tsconfig.json eslint.config.mjs .github/workflows/ci.yml",
    "format": "prettier --write apps packages scripts tests package.json tsconfig.json eslint.config.mjs .github/workflows/ci.yml",
    "test": "node --test tests/*.test.ts",
    "build": "npm run build --workspace=@ronin/portal",
    "verify": "npm run contracts:check && npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:browser && npm run build",
    "test:browser": "node --test tests/browser/*.test.ts",
    "db:dev": "node scripts/dev-db.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@redocly/cli": "2.79.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "10.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "yaml": "2.9.1"
  }
}
